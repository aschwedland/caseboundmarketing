---
// Landing page for the Supabase "Reset Password" email link:
//   https://casebound.co/reset-password?token_hash=…&type=recovery
//
// With the app installed, iOS Universal Links and Android App Links open this
// URL straight in the app (see /.well-known/), so this page is only the
// fallback — App Links not verified yet, an in-app email browser, or a
// computer. It never touches the token itself: it hands it to the app's
// custom scheme, which lands on the same reset screen. The token is single-use,
// so nothing here may fetch or redeem it.
import ProseLayout from '../layouts/ProseLayout.astro';
---

<ProseLayout
  title="Reset your password — Casebound"
  description="Open Casebound to choose a new password."
  canonicalUrl="https://casebound.co/reset-password"
>
  <h1 class="font-serif font-medium text-3xl sm:text-4xl mb-6">Reset your password</h1>

  <div data-reset-state="open" hidden>
    <p class="mb-6">Tap the button to open Casebound and choose a new password.</p>
    <a
      data-open-app
      href="#"
      class="inline-block bg-casebound-green text-casebound-paper px-8 py-3.5 rounded-lg font-medium text-lg hover:opacity-90 transition-opacity"
    >
      Open in Casebound
    </a>
    <p class="text-casebound-muted text-sm mt-8">
      Nothing happened? Make sure Casebound is installed and up to date on this device, then tap the
      link in your email again.
    </p>
  </div>

  <div data-reset-state="desktop" hidden>
    <p class="mb-4">
      Password reset links open in the Casebound app. Open this email on the phone or tablet where
      Casebound is installed and tap the link there.
    </p>
  </div>

  <div data-reset-state="missing" hidden>
    <p class="mb-4">
      This reset link is incomplete. In the Casebound app, tap <strong>Forgot password?</strong> on the
      sign-in screen to get a new email.
    </p>
  </div>

  <noscript>
    <p class="mb-4">
      Open this email on the phone or tablet where Casebound is installed and tap the link there.
    </p>
  </noscript>

  <script is:inline>
    (function () {
      var params = new URLSearchParams(window.location.search);
      var tokenHash = params.get('token_hash');
      var type = params.get('type');

      var ua = navigator.userAgent;
      var isAndroid = /Android/i.test(ua);
      // iPadOS Safari reports a Mac user agent; touch support tells them apart.
      var isIOS = /iPhone|iPad|iPod/i.test(ua) || (/Macintosh/.test(ua) && navigator.maxTouchPoints > 1);

      var state = !tokenHash || type !== 'recovery' ? 'missing' : isAndroid || isIOS ? 'open' : 'desktop';

      if (state === 'open') {
        // Same route the app's Universal Link / App Link lands on.
        var query = 'token_hash=' + encodeURIComponent(tokenHash) + '&type=recovery';
        var href = isAndroid
          ? // Chrome's intent URL: opens the app, or its Play Store listing if it is not installed.
            'intent://reset-password?' + query + '#Intent;scheme=casebound;package=com.pixelmaster.casebound;end'
          : 'casebound://reset-password?' + query;
        document.querySelector('[data-open-app]').setAttribute('href', href);
      }

      var el = document.querySelector('[data-reset-state="' + state + '"]');
      if (el) el.hidden = false;
    })();
  </script>
</ProseLayout>

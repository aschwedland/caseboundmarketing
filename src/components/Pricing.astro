---
import Icon from './Icon.astro';

/**
 * COPY CORRECTIONS (see CONTENT-CHANGES.md):
 *
 * 1. The Free card's sub-line read "No account needed to start". Casebound
 *    requires an account (first-run routes through account-setup/auth), so it
 *    now reads "Free forever, no card required" — which is true.
 *
 * 2. The Pro list read "Data export & the Sepia theme", which contradicted
 *    both the FAQ and this section's own footnote. src/app/export.tsx gates
 *    only the PDF collector's report behind `isPremium`; CSV and JSON export
 *    are free. The bullet now names the PDF report specifically.
 *
 * 3. "Year-in-review wraps" was listed as Pro. It is free — src/app/
 *    year-in-review.tsx opens "a full annual reading summary, free for all
 *    users" and contains no entitlement check. Moved to the Free column.
 *
 * 4. "Cloud sync across devices" was listed as Pro. Nothing gates sync:
 *    src/lib/SyncProvider.tsx has no entitlement checks, an account is
 *    mandatory, and all data is Supabase-backed, so free users already sync.
 *    Removed rather than moved — the app's own upsell strings still market
 *    sync as Pro even though PREMIUM_FEATURES doesn't list it, and the site
 *    shouldn't take a side in that inconsistency. Flagged in TODO_FOR_DREW.
 *
 * The replacement bullets are the real gates, from PREMIUM_FEATURES
 * (src/lib/constants.ts:32-38) plus the checks in useClubJoinAction.ts,
 * library.tsx and appearance.tsx.
 *
 * Prices are unchanged and match what the current live site already shows
 * ($29.99/yr, $4.99/mo) and the app's free-tier copy ("5 lists · basic stats"
 * in src/app/(tabs)/settings.tsx). They still want a StoreKit / Play Billing
 * check before launch — see TODO_FOR_DREW.md.
 */

const free = [
  'Unlimited library & catalog',
  'Reading sessions & basic stats',
  'Up to 5 lists',
  'ISBN scan & title search',
  'Year in Review',
  'CSV & JSON export',
  'Privacy controls',
];

const pro = [
  'Unlimited lists & smart lists',
  'Advanced stats & insights',
  'Unlimited book clubs',
  'Customizable bookshelf & spine photos',
  'PDF collector’s report & the Sepia theme',
];
---

<section id="pricing" class="cb-pricing">
  <div class="cb-pricing-inner">
    <header class="cb-header">
      <p class="cb-eyebrow" data-reveal>Pricing</p>
      <h2 class="cb-h2" data-reveal style="--reveal-delay:60ms">
        Free is useful.<br />Pro is power.
      </h2>
      <p class="cb-lede cb-pricing-lede" data-reveal style="--reveal-delay:100ms">
        Your full library, real session tracking and your data on the way out
        are free forever. Pro adds depth, not permission.
      </p>
    </header>

    <div class="pr-grid">
      <div class="pr-card pr-free" data-reveal style="--reveal-delay:140ms">
        <h3 class="pr-name">Free</h3>
        <p class="pr-sub">Free forever, no card required</p>
        <p class="pr-price">
          <span class="pr-amount tabular">$0</span>
          <span class="pr-period">forever</span>
        </p>
        <ul class="pr-list">
          {
            free.map((f) => (
              <li>
                <span class="pr-check" aria-hidden="true">
                  <Icon name="check" size={15} stroke={2.6} />
                </span>
                <span>{f}</span>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="pr-card pr-pro" data-reveal style="--reveal-delay:180ms">
        <span class="pr-best">Best value</span>
        <h3 class="pr-name pr-name-pro">Pro</h3>
        <p class="pr-sub pr-sub-pro">Everything in Free, plus the power tools</p>
        <p class="pr-price">
          <span class="pr-amount pr-amount-pro tabular">$29.99</span>
          <span class="pr-period pr-period-pro">/year</span>
        </p>
        <p class="pr-savings">Just $2.50/mo · save 50% · or $4.99 monthly</p>
        <ul class="pr-list pr-list-pro">
          {
            pro.map((f) => (
              <li>
                <span class="pr-check pr-check-pro" aria-hidden="true">
                  <Icon name="check" size={15} stroke={2.6} />
                </span>
                <span>{f}</span>
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    <p class="pr-foot" data-reveal style="--reveal-delay:220ms">
      No lifetime tier, no upsells buried in the app. Export your data anytime,
      on any plan.
    </p>
  </div>
</section>

<style>
  .cb-pricing {
    background: var(--color-casebound-paper);
    padding: 104px 32px;
  }

  .cb-pricing-inner {
    max-width: 940px;
    margin: 0 auto;
  }

  .cb-pricing-lede {
    max-width: 560px;
    margin-inline: auto;
  }

  .pr-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 22px;
    align-items: stretch;
  }

  .pr-card {
    position: relative;
    border-radius: 22px;
    padding: 34px 32px;
    display: flex;
    flex-direction: column;
  }

  .pr-free {
    background: var(--color-casebound-surface);
    border: 1px solid var(--color-casebound-border);
  }

  .pr-pro {
    background: #1b3b2c;
    border: 1px solid var(--color-casebound-dark-green);
    color: var(--color-casebound-ink-text);
    box-shadow: 0 30px 60px -30px rgba(35, 74, 55, 0.6);
  }

  .pr-best {
    position: absolute;
    top: 22px;
    right: 26px;
    background: var(--color-casebound-gold-bright);
    color: #3a2e1f;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.3px;
    text-transform: uppercase;
    padding: 4px 8px;
    border-radius: 7px;
  }

  .pr-name {
    font-family: var(--font-serif);
    font-size: 23px;
    font-weight: 600;
    margin: 0;
  }

  .pr-name-pro {
    color: #fff;
  }

  .pr-sub {
    font-size: 14px;
    color: var(--color-casebound-faint-strong);
    margin: 4px 0 0;
  }

  .pr-sub-pro {
    color: #a6d7bc;
  }

  .pr-price {
    display: flex;
    align-items: baseline;
    gap: 8px;
    margin: 22px 0 0;
  }

  .pr-amount {
    font-weight: 700;
    font-size: 46px;
    line-height: 1;
  }

  .pr-amount-pro {
    color: #fff;
  }

  .pr-period {
    font-size: 15px;
    color: var(--color-casebound-muted);
  }

  .pr-period-pro {
    color: #a6d7bc;
  }

  .pr-savings {
    font-size: 13.5px;
    color: #8fbba3;
    margin: 10px 0 0;
  }

  .pr-list {
    list-style: none;
    margin: 26px 0 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 12px;
    font-size: 15px;
    line-height: 1.45;
  }

  .pr-list-pro {
    color: #eaf3ed;
  }

  .pr-list li {
    display: flex;
    gap: 11px;
  }

  .pr-check {
    flex: none;
    line-height: 0;
    margin-top: 3px;
    color: var(--color-casebound-green);
  }

  .pr-check-pro {
    color: var(--color-casebound-gold-bright);
  }

  .pr-foot {
    text-align: center;
    font-size: 14px;
    color: var(--color-casebound-faint-strong);
    margin: 26px 0 0;
  }

  @media (max-width: 1023px) {
    .cb-pricing {
      padding: 72px 24px;
    }
  }

  @media (max-width: 899px) {
    .pr-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 767px) {
    .cb-pricing {
      padding: 56px 20px;
    }
    .pr-card {
      padding: 26px 22px;
    }
  }
</style>

---
import Cover from './Cover.astro';
import Icon from './Icon.astro';
import { COVERS } from '../config/site';

const lists = [
  { name: 'To be read', count: 24, spines: ['#A8492C', '#2E5D45', '#3E5F79'] },
  { name: 'Favorites', count: 12, spines: ['#8A6A1F', '#5B6B82', '#7A4A6B'] },
  { name: 'Sci-fi & fantasy', count: 38, spines: ['#2E5D45', '#3E5F79', '#A8492C'] },
];
---

<section id="architecture" class="cb-arch">
  <div class="cb-arch-inner">
    <header class="cb-header cb-arch-header">
      <p class="cb-eyebrow" data-reveal>The architecture</p>
      <h2 class="cb-h2" data-reveal style="--reveal-delay:60ms">
        Library and lists,<br />finally separate.
      </h2>
      <p class="cb-lede" data-reveal style="--reveal-delay:100ms">
        Most apps mash your shelves, reading status, and custom lists into one
        pile. Casebound keeps a canonical library — what you own, in what
        format, where you are — and lets lists layer on top as tags. A book
        lives in your library once, in zero or many lists.
      </p>
    </header>

    <div class="cb-diagram" data-reveal style="--reveal-delay:140ms">
      <div class="dg-side">
        <p class="dg-label dg-label-green">Library entry · one record</p>
        <div class="dg-entry">
          <div class="dg-entry-top">
            <Cover cover={COVERS.nameOfTheWind} width={44} height={66} radius={4} />
            <div class="dg-entry-text">
              <div class="dg-entry-title">The Name of the Wind</div>
              <div class="dg-entry-author">Patrick Rothfuss</div>
              <div class="dg-micro">
                <span class="dg-badge" style="background:#E3EDE5;color:#234A37">Reading</span>
                <span class="dg-badge" style="background:#F2ECE0;color:#6E6557">Owned</span>
              </div>
            </div>
          </div>
          <div class="dg-chips">
            <span class="dg-chip"><Icon name="book" size={12} stroke={2} />Print</span>
            <span class="dg-chip"><Icon name="headphones" size={12} stroke={2} />Audio</span>
          </div>
        </div>
      </div>

      <div class="dg-connector" aria-hidden="true">
        <svg width="120" height="180" viewBox="0 0 120 180" fill="none" aria-hidden="true">
          <defs>
            <marker
              id="cb-arch-arrow"
              markerWidth="9"
              markerHeight="7"
              refX="9"
              refY="3.5"
              orient="auto"
            >
              <polygon points="0 0, 9 3.5, 0 7" fill="#8A6A1F" />
            </marker>
          </defs>
          <line x1="6" y1="90" x2="96" y2="34" stroke="#8A6A1F" stroke-width="2"
            stroke-dasharray="4 5" marker-end="url(#cb-arch-arrow)" />
          <line x1="6" y1="90" x2="96" y2="90" stroke="#8A6A1F" stroke-width="2"
            stroke-dasharray="4 5" marker-end="url(#cb-arch-arrow)" />
          <line x1="6" y1="90" x2="96" y2="146" stroke="#8A6A1F" stroke-width="2"
            stroke-dasharray="4 5" marker-end="url(#cb-arch-arrow)" />
        </svg>
      </div>

      <div class="dg-side">
        <p class="dg-label dg-label-gold">Lists · zero or many tags</p>
        <ul class="dg-lists">
          {
            lists.map((l) => (
              <li class="dg-list">
                <span class="dg-spines" aria-hidden="true">
                  {l.spines.map((c) => (
                    <span class="dg-spine" style={`background:${c}`} />
                  ))}
                </span>
                <span class="dg-listname">{l.name}</span>
                <span class="dg-count tabular">{l.count}</span>
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    <p class="cb-arch-note" data-reveal style="--reveal-delay:180ms">
      Ownership, format, status and privacy are each first-class fields —
      search or filter by any of them.
    </p>
  </div>
</section>

<style>
  .cb-arch {
    background: var(--color-casebound-paper);
    padding: 108px 32px;
  }

  .cb-arch-inner {
    max-width: 1080px;
    margin: 0 auto;
  }

  .cb-arch-header {
    max-width: 660px;
  }

  .cb-diagram {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    gap: 20px;
    align-items: center;
    background: var(--color-casebound-surface);
    border: 1px solid var(--color-casebound-border);
    border-radius: 24px;
    padding: 38px 34px;
    box-shadow: 0 24px 60px -30px rgba(43, 38, 32, 0.2);
  }

  .dg-label {
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.8px;
    text-transform: uppercase;
    margin: 0 0 12px;
  }
  .dg-label-green {
    color: var(--color-casebound-dark-green);
  }
  .dg-label-gold {
    color: var(--color-casebound-gold);
  }

  .dg-entry {
    border: 2px solid var(--color-casebound-green);
    border-radius: 16px;
    background: #f6faf7;
    padding: 14px;
  }

  .dg-entry-top {
    display: flex;
    gap: 12px;
  }

  .dg-entry-text {
    min-width: 0;
  }

  .dg-entry-title {
    font-family: var(--font-serif);
    font-size: 15px;
    font-weight: 600;
    line-height: 1.2;
  }

  .dg-entry-author {
    font-size: 12.5px;
    color: var(--color-casebound-muted);
    margin-top: 3px;
  }

  .dg-micro {
    display: flex;
    gap: 5px;
    margin-top: 8px;
  }

  .dg-badge {
    font-size: 10px;
    font-weight: 600;
    padding: 3px 6px;
    border-radius: 5px;
  }

  .dg-chips {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 8px;
    margin-top: 12px;
  }

  .dg-chip {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 5px;
    background: var(--color-casebound-surface);
    border: 1px solid var(--color-casebound-border);
    border-radius: 8px;
    padding: 7px 6px;
    font-size: 11px;
    font-weight: 600;
    color: var(--color-casebound-muted);
  }

  .dg-connector {
    line-height: 0;
  }

  .dg-lists {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .dg-list {
    display: flex;
    align-items: center;
    gap: 12px;
    border: 1.5px solid var(--color-casebound-border);
    border-radius: 12px;
    padding: 11px 14px;
    background: var(--color-casebound-surface);
  }

  .dg-spines {
    display: flex;
    flex: none;
  }

  .dg-spine {
    width: 9px;
    height: 22px;
    border-radius: 2px;
  }
  .dg-spine + .dg-spine {
    margin-left: -3px;
  }

  .dg-listname {
    font-size: 14px;
    font-weight: 600;
    flex: 1;
    min-width: 0;
  }

  .dg-count {
    font-size: 12px;
    color: var(--color-casebound-faint-strong);
  }

  .cb-arch-note {
    text-align: center;
    font-size: 14.5px;
    color: var(--color-casebound-faint-strong);
    margin: 22px 0 0;
  }

  @media (max-width: 1023px) {
    .cb-arch {
      padding: 72px 24px;
    }
    .cb-diagram {
      grid-template-columns: 1fr;
      gap: 4px;
      padding: 28px 24px;
    }
    /* Three dashed lines should fan downward once the halves stack. */
    .dg-connector {
      display: grid;
      place-items: center;
      height: 120px;
    }
    .dg-connector svg {
      transform: rotate(90deg);
    }
  }

  @media (max-width: 767px) {
    .cb-arch {
      padding: 56px 20px;
    }
    .dg-connector {
      height: 96px;
    }
    .dg-connector svg {
      transform: rotate(90deg) scale(0.8);
    }
  }
</style>

---
import Icon from './Icon.astro';

const builtFor = [
  'Readers with substantial libraries — often 100 books or more.',
  'People who want to be good stewards of what they own.',
  'Anyone who wants meaningful reading data without performance theater.',
];

const notBuiltFor = [
  'Casual readers chasing yearly book-count goals.',
  'Review writers chasing social validation.',
  'People who want an algorithm to decide what they read next.',
];
---

<section id="who" class="cb-who">
  <div class="cb-who-inner">
    <header class="cb-header">
      <p class="cb-eyebrow" data-reveal>Who it's for</p>
      <h2 class="cb-h2" data-reveal style="--reveal-delay:60ms">
        Not for everyone.<br />On purpose.
      </h2>
    </header>

    <div class="wh-grid">
      <div class="wh-card wh-card-for" data-reveal style="--reveal-delay:100ms">
        <span class="wh-tile wh-tile-for"><Icon name="check" size={18} stroke={2.8} /></span>
        <h3 class="wh-title wh-title-for">Built for</h3>
        <ul class="wh-list">
          {
            builtFor.map((item) => (
              <li>
                <span class="wh-bullet wh-bullet-for" aria-hidden="true">
                  <Icon name="check" size={15} stroke={2.6} />
                </span>
                <span>{item}</span>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="wh-card wh-card-not" data-reveal style="--reveal-delay:140ms">
        <span class="wh-tile wh-tile-not"><Icon name="x" size={18} stroke={2.8} /></span>
        <h3 class="wh-title wh-title-not">Not built for</h3>
        <ul class="wh-list wh-list-not">
          {
            notBuiltFor.map((item) => (
              <li>
                <span class="wh-bullet wh-bullet-not" aria-hidden="true">
                  <Icon name="x" size={15} stroke={2.6} />
                </span>
                <span>{item}</span>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </div>
</section>

<style>
  .cb-who {
    background: var(--color-casebound-surface);
    border-top: 1px solid var(--color-casebound-border);
    padding: 104px 32px;
  }

  .cb-who-inner {
    max-width: 1000px;
    margin: 0 auto;
  }

  .wh-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 22px;
  }

  .wh-card {
    border-radius: 20px;
    padding: 32px 30px;
  }

  .wh-card-for {
    background: var(--color-casebound-green-tint);
    border: 1px solid rgba(46, 93, 69, 0.2);
  }

  .wh-card-not {
    background: var(--color-casebound-paper);
    border: 1px solid var(--color-casebound-border);
  }

  .wh-tile {
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    border-radius: 9px;
    margin-bottom: 14px;
  }

  .wh-tile-for {
    background: var(--color-casebound-green);
    color: #fff;
  }

  .wh-tile-not {
    background: var(--color-casebound-border);
    color: var(--color-casebound-muted);
  }

  .wh-title {
    font-family: var(--font-serif);
    font-size: 20px;
    font-weight: 600;
    margin: 0 0 16px;
  }

  .wh-title-for {
    color: var(--color-casebound-dark-green);
  }

  .wh-title-not {
    color: var(--color-casebound-muted);
  }

  .wh-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 13px;
    font-size: 15.5px;
    line-height: 1.5;
    color: var(--color-casebound-text);
  }

  .wh-list-not {
    color: var(--color-casebound-muted);
  }

  .wh-list li {
    display: flex;
    gap: 11px;
  }

  .wh-bullet {
    flex: none;
    line-height: 0;
    margin-top: 3px;
  }

  .wh-bullet-for {
    color: var(--color-casebound-green);
  }

  .wh-bullet-not {
    color: var(--color-casebound-faint-strong);
  }

  @media (max-width: 1023px) {
    .cb-who {
      padding: 72px 24px;
    }
  }

  @media (max-width: 767px) {
    .cb-who {
      padding: 56px 20px;
    }
    .wh-grid {
      grid-template-columns: 1fr;
    }
    .wh-card {
      padding: 26px 22px;
    }
  }
</style>

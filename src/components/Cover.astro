---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import type { CoverMeta } from '../config/site';

/**
 * A book cover with a solid fallback behind it.
 *
 * The fallback color is painted on the wrapper, not swapped in by JS, so a
 * cover that fails to load degrades to a colored spine rather than a hole —
 * and there is no flash of empty box before the image decodes.
 *
 * Covers are decorative here: they illustrate product UI inside phone mockups
 * that already carry their own `role="img"` description, so the `<img>` is
 * always `alt=""`.
 */

interface Props {
  cover: CoverMeta;
  width: number;
  height: number;
  radius?: number;
  class?: string;
  style?: string;
  loading?: 'lazy' | 'eager';
}

const images = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/covers/*.png',
  { eager: true },
);

const {
  cover,
  width,
  height,
  radius = 5,
  class: className = '',
  style = '',
  loading = 'lazy',
} = Astro.props;

const entry = images[`../assets/covers/${cover.slug}.png`];

if (!entry) {
  throw new Error(
    `Cover asset missing: src/assets/covers/${cover.slug}.png. ` +
      `Add the file or update COVERS in src/config/site.ts.`,
  );
}
---

<div
  class={`cb-cover shrink-0 overflow-hidden ${className}`}
  style={`width:${width}px;height:${height}px;border-radius:${radius}px;background:${cover.fallback};${style}`}
>
  <Image
    src={entry.default}
    alt=""
    width={width * 2}
    height={height * 2}
    loading={loading}
    decoding="async"
    class="block h-full w-full object-cover"
  />
</div>

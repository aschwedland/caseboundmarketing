---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

/**
 * CARRIED FORWARD from the current site at Drew's request.
 *
 * The new design deliberately drops the real screenshots in favour of
 * hand-built mockups (so motion and theming can be controlled), which left the
 * page with no actual product photography. This puts it back — but rebuilt as
 * a native scroll-snap strip rather than the old 200-line pointer/wheel/
 * keyboard carousel. CSS scroll-snap gets drag, momentum, keyboard and
 * touch behaviour from the browser for free, ships zero JavaScript, and can't
 * trap focus the way the hand-rolled version could.
 *
 * Alt text is carried over verbatim from ScreenshotShowcase.astro.
 */

const shots = [
  { file: 'casebound-ss-01', alt: 'Casebound library view: a list of books with cover thumbnails, status pills, and format icons.' },
  { file: 'casebound-ss-02', alt: 'Book detail page showing the same book tracked as hardcover and audiobook, each with its own progress.' },
  { file: 'casebound-ss-03', alt: 'A live reading session timer with the current book and elapsed minutes.' },
  { file: 'casebound-ss-04', alt: 'Filter and sort controls — status, format, ownership, and list, all selectable.' },
  { file: 'casebound-ss-05', alt: 'ISBN barcode scanner viewfinder over a book’s back cover.' },
  { file: 'casebound-ss-06', alt: 'Custom lists view showing tags layered on top of the canonical library.' },
  { file: 'casebound-ss-07', alt: 'Next-read randomizer suggesting a book from the to-be-read shelf.' },
  { file: 'casebound-ss-08', alt: 'Pricing screen with Free and Pro tier cards side by side.' },
];

const images = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/screenshots/*.png',
  { eager: true },
);
---

<section id="screenshots" class="cb-shots">
  <div class="cb-shots-head">
    <p class="cb-eyebrow" data-reveal>The real thing</p>
    <h2 class="cb-h2" data-reveal style="--reveal-delay:60ms">
      Not a mockup.<br />The actual app.
    </h2>
    <p class="cb-lede" data-reveal style="--reveal-delay:100ms">
      Everything above is drawn to show you how it works. Here are eight
      unretouched screens from the app itself.
    </p>
  </div>

  {/* role="region" belongs on the wrapper, not the <ul>. Putting it on the
      list itself overrides the implicit `list` role and orphans every <li>,
      which is an aria-required-parent violation and stops screen readers
      announcing "list, 8 items". The wrapper is also what scrolls, so it is
      the correct thing to make keyboard-focusable. */}
  <div
    class="sh-strip"
    tabindex="0"
    role="region"
    aria-label="App screenshots — scroll horizontally to see all eight"
  >
    <ul class="sh-list">
      {
        shots.map((s) => (
          <li class="sh-item">
            <Image
              src={images[`../assets/screenshots/${s.file}.png`]!.default}
              alt={s.alt}
              widths={[280, 560]}
              sizes="(max-width: 767px) 220px, 280px"
              loading="lazy"
              decoding="async"
              class="sh-img"
            />
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .cb-shots {
    background: var(--color-casebound-wallpaper);
    padding: 104px 0;
    overflow: hidden;
  }

  .cb-shots-head {
    max-width: 1180px;
    margin: 0 auto 44px;
    padding: 0 32px;
    text-align: center;
  }

  .cb-shots-head .cb-lede {
    max-width: 560px;
    margin-inline: auto;
  }

  .sh-strip {
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    /* Native momentum + drag on touch, a real scrollbar on desktop. */
    -webkit-overflow-scrolling: touch;
    scrollbar-color: var(--color-casebound-border-strong) transparent;
  }

  .sh-list {
    display: flex;
    gap: 22px;
    list-style: none;
    margin: 0;
    padding: 8px 32px 24px;
  }

  .sh-item {
    flex: none;
    scroll-snap-align: center;
  }

  .sh-img {
    display: block;
    width: 280px;
    height: auto;
    border-radius: 22px;
    box-shadow: 0 24px 60px -30px rgba(43, 38, 32, 0.45);
  }

  @media (max-width: 1023px) {
    .cb-shots {
      padding: 72px 0;
    }
    .cb-shots-head {
      padding: 0 24px;
      margin-bottom: 32px;
    }
    .sh-list {
      padding: 8px 24px 20px;
    }
  }

  @media (max-width: 767px) {
    .cb-shots {
      padding: 56px 0;
    }
    .cb-shots-head {
      padding: 0 20px;
    }
    .sh-list {
      gap: 16px;
      padding: 8px 20px 18px;
    }
    .sh-img {
      width: 220px;
      border-radius: 18px;
    }
  }
</style>
